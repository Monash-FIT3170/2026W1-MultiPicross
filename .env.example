POSTGRES_USER=picross
POSTGRES_PASSWORD=picross
POSTGRES_DB=picross

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# OIDC SSO, run as a backend-for-frontend in the API (see api/src/auth/oidc.ts).
APP_BASE_URL=http://multipicross.localhost
# Dex, the local dev stand-in for the real IdP (see dev/dex/config.yaml).
# Login with dev@multipicross.localhost / picross-dev.
OIDC_ISSUER=http://dex.multipicross.localhost
# Namespaces stored identities. Must be set explicitly per environment, and
# changing it orphans every existing identity row.
OIDC_PROVIDER_ID=dev
OIDC_CLIENT_ID=multipicross-dev
OIDC_CLIENT_SECRET=multipicross-dev-secret
OIDC_SCOPES=openid
OIDC_CLIENT_AUTH=client_secret_basic
OIDC_ANCHOR_CLAIM=sub
OIDC_ALLOW_INSECURE=true
# Generate with: openssl rand -hex 32
OIDC_STATE_SECRET=change-me-oidc-state-secret

# Seeds a kind=service account on boot if both are set; safe to leave unset
# once seeded, since the boot check is idempotent and never resets a password.
ADMIN_USERNAME=change-me-admin
ADMIN_PASSWORD=change-me-admin-password
